# Configuration reference. Spring Boot does NOT automatically load this file.
# Set these values in the Java process environment or IDE run configuration.
# Use your own credentials. Never commit a filled-in .env file.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=daily_time
MYSQL_USERNAME=daily_time_app
MYSQL_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com
LLM_MODEL=gpt-4.1-mini

DAILY_TIME_AGENT_ENABLED=true
# Replace with the absolute path to YOUR project root (not daily-time-server).
DAILY_TIME_PROJECT_ROOT=C:/path/to/daily-time
PYTHON_COMMAND=python
NODE_COMMAND=node
OPENCLAW_NOTIFICATIONS_ENABLED=true
OPENCLAW_COMMAND=openclaw.cmd
OPENCLAW_CDP_URL=http://127.0.0.1:18800
SERVER_PORT=8080
# For a NEW empty database: explicitly set true to run V1-V3 migrations.
# Existing databases: check migration history before enabling.
FLYWAY_ENABLED=false
