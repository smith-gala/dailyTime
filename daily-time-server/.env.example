# Configuration reference only; Spring Boot does NOT load .env automatically.
# The complete configuration example is ../.env.example.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=daily_time
MYSQL_USERNAME=daily_time_app
MYSQL_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com
LLM_MODEL=gpt-4.1-mini
DAILY_TIME_PROJECT_ROOT=C:/path/to/daily-time
PYTHON_COMMAND=python
NODE_COMMAND=node
OPENCLAW_COMMAND=openclaw.cmd
OPENCLAW_NOTIFICATIONS_ENABLED=true
# Enable only after checking the target database; true for a new empty database.
FLYWAY_ENABLED=false
